{
  "name": "@forge/docs-generation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Generating Documents",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./migrations/*": "./migrations/*"
  },
  "dependencies": {
    "@forge/data-files": "workspace:*",
    "@forge/kernel-data": "workspace:*",
    "@forge/kernel-events": "workspace:*",
    "@forge/kernel-identity": "workspace:*",
    "@forge/kernel-money": "workspace:*",
    "drizzle-orm": "0.44.2",
    "zod": "3.23.8"
  },
  "peerDependencies": {
    "playwright": ">=1.50",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  }
}
