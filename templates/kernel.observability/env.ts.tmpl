import { z } from 'zod'

// The environment variable schema for every credential declared across the
// resolved graph. Names and types only — never values. Boots fail fast here
// rather than at the first request that needs a missing key.
const schema = z.object({
  DATABASE_URL: z.string().min(1),
{{- range .Graph.EnvVars }}
  {{ . }}: z.string().min(1),
{{- end }}
})

export const env = schema.parse(process.env)
