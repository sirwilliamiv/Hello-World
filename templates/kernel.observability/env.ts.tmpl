import { z } from 'zod'

// The environment variable schema for every credential declared across the
// resolved graph. Names and types only — never values. Boots fail fast here
// rather than at the first request that needs a missing key.
const schema = z.object({
  DATABASE_URL: z.string().min(1),
{{- range .Graph.EnvVars }}
  {{ . }}: z.string().min(1),
{{- end }}
{{- range .Graph.OptionalEnvVars }}
  {{ . }}: z.string().optional(),  // declared optional by its capability
{{- end }}
})

export type Env = z.infer<typeof schema>

// Next imports every route module at build time to collect page data, with no
// real environment present. Validating eagerly there would make `next build`
// require production secrets — and building is not running, so it must not.
//
// At runtime the eager parse stays: a missing credential fails at boot rather
// than at the first request that happens to need it.
const isBuild = process.env.NEXT_PHASE === 'phase-production-build'

export const env: Env = isBuild
  ? (process.env as unknown as Env)
  : schema.parse(process.env)
