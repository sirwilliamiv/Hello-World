import { createRequire } from 'node:module'
import path from 'node:path'
import { drizzle } from 'drizzle-orm/postgres-js'
import postgres from 'postgres'
import { configureData, runMigrations } from '@forge/kernel-data'

// The data layer has no connection until something gives it one. The runner is
// a standalone script — nothing has booted the app — so it configures the layer
// itself rather than assuming a caller already did.
const url = process.env.DATABASE_URL
if (url === undefined || url === '') {
  console.error('DATABASE_URL is not set. Migrations need a database to run against.')
  process.exit(1)
}

// max: 1 — migrations must run on a single connection, in order. A pool would
// let two migrations interleave and a transaction-scoped lock would not hold
// across them.
const sql = postgres(url, { max: 1 })
configureData({ database: drizzle(sql) })

// Ordered by migration id, which is date-prefixed and immutable once published.
// Every migration ships a rollback; publication fails without one.
const migrations = [
{{- range .Graph.Migrations }}
  { capability: {{ .Capability | quote }}, id: {{ .ID | quote }}, up: {{ .Up | quote }}, down: {{ .Down | quote }} },
{{- end }}
  { capability: '<client>', id: '0001_client_entities', up: 'migrations/client/0001_client_entities.sql', down: '' },
]

// A migration ships inside its capability's npm package, so its recorded path is
// a package specifier rather than a repo-relative one — it must resolve wherever
// the package is installed, not wherever this script happens to run.
const require = createRequire(import.meta.url)
function resolveMigration(spec: string): string {
  if (!spec.startsWith('@')) return spec
  const [scope, name, ...rest] = spec.split('/')
  const manifest = require.resolve(`${scope}/${name}/package.json`)
  return path.join(path.dirname(manifest), ...rest)
}

const resolved = migrations.map((m) => ({
  ...m,
  up: resolveMigration(m.up),
  down: m.down === '' ? '' : resolveMigration(m.down),
}))

const result = await runMigrations(resolved, { root: process.cwd() })
console.log(`applied ${result.applied.length}, already present ${result.skipped.length}`)
await sql.end()
