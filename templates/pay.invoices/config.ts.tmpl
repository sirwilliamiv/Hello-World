import { configureInvoices } from '@forge/pay-invoices'
import * as slots from '@/slots/pay.invoices'

configureInvoices({
  // Numbering is gapless and sequential PER LEGAL ENTITY. The sequence is
  // allocated inside the insert transaction, so a rolled-back invoice does not
  // burn a number and two concurrent inserts cannot share one.
  legalEntity: {{ .Product.Client.LegalEntity | quote }},
  numberingScheme: {{ cfgStr .Config "numbering_scheme" "INV-{YYYY}-{SEQ:5}" | quote }},
  paymentTermsDays: {{ cfg .Config "payment_terms_days" 30 }},
  overdueCheckCron: {{ cfgStr .Config "overdue_check_cron" "0 6 * * *" | quote }},
  slots,
})
